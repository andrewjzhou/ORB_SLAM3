# udev rules for INDEMIND stereo-inertial camera (OmniVision OV580, VID 05a9)
# Install with:
#   sudo cp 99-indemind.rules /etc/udev/rules.d/
#   sudo udevadm control --reload-rules && sudo udevadm trigger
# Then unplug and re-plug the camera.

SUBSYSTEM=="usb", ATTR{idVendor}=="05a9", MODE="0666", GROUP="plugdev"
